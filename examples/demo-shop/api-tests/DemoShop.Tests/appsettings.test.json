{
  "Identities": [
    { "Name": "admin", "Role": "Admin" },
    { "Name": "user", "Role": "User" }
  ],
  "Services": {
    // AuthClient: the OAuth2 client (Authentication:Clients) of the service's group
    "AuthService":    { "BaseUrl": "http://localhost:5300" },
    "ProductService": { "BaseUrl": "http://localhost:5100", "AuthClient": "Catalog" },
    "OrderService":   { "BaseUrl": "http://localhost:5200", "AuthClient": "Orders" }
  },
  "Authentication": {
    // Services without an AuthClient: the user token of the global setup
    "Mode": "SessionToken",
    "HeaderName": "Authorization",
    "Scheme": "Bearer",
    // Shared authorization server; the clients inherit it (and everything else but credentials)
    "OAuth2": { "TokenUrl": "http://localhost:5300/connect/token" },
    "Clients": {
      // Client secrets never live here: .env locally, CI secrets in pipelines
      //   TEST_Authentication__Clients__Catalog__OAuth2__ClientSecret / ...__Orders__...
      "Catalog": {
        "Mode": "OAuth2ClientCredentials",
        "OAuth2": {
          "ClientId": "catalog-api-tests",
          "Scope": "catalog.read catalog.write catalog.admin"
        }
      },
      "Orders": {
        "Mode": "OAuth2ClientCredentials",
        "OAuth2": {
          "ClientId": "orders-api-tests",
          "Scope": "orders.read orders.write catalog.read"
        }
      }
    }
  },
  "ContractValidation": {
    "Mode": "Fail",
    "Specs": {
      "AuthService":    "swagger/auth-swagger.json",
      "ProductService": "swagger/product-swagger.json",
      "OrderService":   "swagger/order-swagger.json"
    },
    "StrictObjects": true
  },
  "DefaultTimeoutSeconds": 30,
  "RetryCount": 0,
  "Environment": "Development"
}
