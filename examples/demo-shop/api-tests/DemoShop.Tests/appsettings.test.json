{
  "Identities": [
    { "Name": "admin", "Role": "Admin" },
    { "Name": "user", "Role": "User" }
  ],
  "Services": {
    "AuthService":    { "BaseUrl": "http://localhost:5300" },
    "ProductService": { "BaseUrl": "http://localhost:5100" },
    "OrderService":   { "BaseUrl": "http://localhost:5200" }
  },
  "Authentication": {
    "Mode": "SessionToken",
    "HeaderName": "Authorization",
    "Scheme": "Bearer"
  },
  "ContractValidation": {
    "Mode": "Fail",
    "Specs": {
      "AuthService":    "swagger/auth-swagger.json",
      "ProductService": "swagger/product-swagger.json",
      "OrderService":   "swagger/order-swagger.json"
    },
    "StrictObjects": true
  },
  "DefaultTimeoutSeconds": 30,
  "RetryCount": 0,
  "Environment": "Development"
}
