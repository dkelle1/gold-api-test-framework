{
  "swaggerDir": "DemoShop.Clients/swagger",
  "collectionName": "DemoShop",
  "output": {
    "collections": "../collections",
    "k6": "../perf/k6",
    "reports": "../../../TestResults"
  },
  "services": [
    { "key": "auth",    "name": "AuthService",    "swagger": "auth-swagger.json",    "baseUrl": "http://localhost:5300", "envVar": "AUTH_BASE_URL", "authIssuer": true },
    { "key": "product", "name": "ProductService", "swagger": "product-swagger.json", "baseUrl": "http://localhost:5100", "envVar": "PRODUCT_BASE_URL" },
    { "key": "order",   "name": "OrderService",   "swagger": "order-swagger.json",   "baseUrl": "http://localhost:5200", "envVar": "ORDER_BASE_URL" }
  ]
}
