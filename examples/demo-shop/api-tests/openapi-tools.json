{
  "swaggerDir": "DemoShop.Clients/swagger",
  "collectionName": "DemoShop",
  "output": {
    "collections": "../collections",
    "k6": "../perf/k6",
    "reports": "../../../TestResults"
  },
  "services": [
    { "key": "auth",    "name": "AuthService",    "swagger": "auth-swagger.json",    "baseUrl": "http://localhost:5300", "envVar": "AUTH_BASE_URL", "authIssuer": true },
    { "key": "product", "name": "ProductService", "swagger": "product-swagger.json", "baseUrl": "http://localhost:5100", "envVar": "PRODUCT_BASE_URL", "authClient": "Catalog" },
    { "key": "order",   "name": "OrderService",   "swagger": "order-swagger.json",   "baseUrl": "http://localhost:5200", "envVar": "ORDER_BASE_URL",   "authClient": "Orders" }
  ],
  "authClients": {
    "Catalog": { "tokenUrl": "/connect/token", "clientId": "catalog-api-tests", "scope": "catalog.read catalog.write catalog.admin" },
    "Orders":  { "tokenUrl": "/connect/token", "clientId": "orders-api-tests",  "scope": "orders.read orders.write catalog.read" }
  }
}
