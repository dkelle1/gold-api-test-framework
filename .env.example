# ─────────────────────────────────────────────────────────────────────────────
# Configuration template. Copy to ".env" (git-ignored) and uncomment what you need:
#   cp .env.example .env
#
# Who reads it
#   - .NET tests: the nearest .env above the test assembly (or the file in TEST_ENV_FILE)
#   - Python tools (tools/*.py): the nearest .env above the current directory
#   - docker compose: only with --env-file .env (see the "Example stack" section)
# Precedence: real environment variables > .env > appsettings.test.{TEST_ENVIRONMENT}.json
#             > appsettings.test.json. Values shown are the defaults.
#
# Keys for the .NET tests are the configuration paths with the TEST_ prefix and "__" between
# sections (Services:OrderService:BaseUrl -> TEST_Services__OrderService__BaseUrl).
# Lists use indexes (TEST_Identities__0__Name). Quote values containing " #".
# ─────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# Loads appsettings.test.<name>.json on top of appsettings.test.json
# TEST_ENVIRONMENT=Development

# ── Services under test (one ApiClient per entry; the Python tools use them too) ─
# TEST_Services__AuthService__BaseUrl=http://localhost:5300
# TEST_Services__ProductService__BaseUrl=http://localhost:5100
# TEST_Services__OrderService__BaseUrl=http://localhost:5200

# ── HTTP behaviour ───────────────────────────────────────────────────────────
# TEST_DefaultTimeoutSeconds=30
# Retries of transient failures (idempotent methods; POST/PATCH only without any response)
# TEST_RetryCount=0

# ── Authentication (docs/framework/authentication.md) ───────────────────────
# Mode: SessionToken | OAuth2ClientCredentials | ApiKey | StaticToken | None | Custom
# TEST_Authentication__Mode=SessionToken
# TEST_Authentication__HeaderName=Authorization
# TEST_Authentication__Scheme=Bearer
# TEST_Authentication__Token=
# TEST_Authentication__ApiKey=
# TEST_Authentication__OAuth2__TokenUrl=https://login.example.com/connect/token
# TEST_Authentication__OAuth2__ClientId=api-tests
# TEST_Authentication__OAuth2__ClientSecret=
# TEST_Authentication__OAuth2__Scope=
# TEST_Authentication__OAuth2__Audience=
# TEST_Authentication__CustomProviderType=MyProduct.Tests.Auth.MyProvider, MyProduct.Tests

# Named auth clients, one per group of services (Services:<Name>:AuthClient selects one).
# Same keys as above under Clients__<Client>__; credentials are never inherited.
# TEST_Services__ProductService__AuthClient=Catalog
# TEST_Authentication__Clients__Catalog__Mode=OAuth2ClientCredentials
# TEST_Authentication__Clients__Catalog__OAuth2__ClientId=catalog-api-tests
# TEST_Authentication__Clients__Catalog__OAuth2__ClientSecret=catalog-api-tests-secret
# TEST_Authentication__Clients__Catalog__OAuth2__Scope=catalog.read catalog.write catalog.admin
# TEST_Authentication__Clients__Orders__OAuth2__ClientSecret=orders-api-tests-secret

# Identities provisioned by the global setup (indexes replace the whole list from appsettings)
# TEST_Identities__0__Name=admin
# TEST_Identities__0__Role=Admin
# TEST_Identities__1__Name=user
# TEST_Identities__1__Role=User

# ── Contract validation (docs/framework/contracts.md) ───────────────────────
# Mode: Off | Warn | Fail
# TEST_ContractValidation__Mode=Fail
# TEST_ContractValidation__StrictObjects=true
# TEST_ContractValidation__ReportDirectory=contract-coverage
# TEST_ContractValidation__Specs__OrderService=swagger/order-swagger.json

# ── Python tools (docs/framework/python-tooling.md) ─────────────────────────
# Tools config (services, swagger dir, output dirs)
# OPENAPI_TOOLS_CONFIG=examples/demo-shop/api-tests/openapi-tools.json
# Role of the user the smoke runner registers (admin-only endpoints need Admin)
# SMOKE_ROLE=Admin
# Tool-specific base URLs win over TEST_Services__<Name>__BaseUrl
# AUTH_BASE_URL=http://localhost:5300
# PRODUCT_BASE_URL=http://localhost:5100
# ORDER_BASE_URL=http://localhost:5200

# ── Example stack (examples/demo-shop/docker-compose.yml) ───────────────────
#   docker compose --env-file .env -f examples/demo-shop/docker-compose.yml up -d --build --wait
# Changing a port? Change the matching TEST_Services__…__BaseUrl too.
# SQL_PORT=1433
# REDIS_PORT=6379
# AUTH_PORT=5300
# PRODUCT_PORT=5100
# ORDER_PORT=5200
# SA_PASSWORD=ApiTest_Sa@2024
# JWT_SECRET_KEY=ApiTestFramework_SuperSecretKey_ForDevelopment_2024_MinLength32!
# Client secrets of the demo authorization server (match TEST_Authentication__Clients__…__ClientSecret)
# CATALOG_CLIENT_SECRET=catalog-api-tests-secret
# ORDERS_CLIENT_SECRET=orders-api-tests-secret
