{
  "openapi": "3.0.1",
  "info": {
    "title": "Order Service API",
    "description": "Microservice for managing orders. Depends on Product Service for product validation.",
    "version": "v1"
  },
  "paths": {
    "/api/orders": {
      "get": {
        "tags": [ "Orders" ],
        "operationId": "GetAllOrders",
        "security": [ { "Bearer": [] } ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Order" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "tags": [ "Orders" ],
        "operationId": "CreateOrder",
        "security": [ { "Bearer": [] } ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateOrderRequest" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "400": { "description": "Bad Request" },
          "401": { "description": "Unauthorized" }
        }
      }
    },
    "/api/orders/{id}": {
      "get": {
        "tags": [ "Orders" ],
        "operationId": "GetOrderById",
        "security": [ { "Bearer": [] } ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not Found" }
        }
      },
      "put": {
        "tags": [ "Orders" ],
        "operationId": "UpdateOrder",
        "security": [ { "Bearer": [] } ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateOrderRequest" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/Order" }
              }
            }
          },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not Found" }
        }
      },
      "delete": {
        "tags": [ "Orders" ],
        "operationId": "DeleteOrder",
        "security": [ { "Bearer": [] } ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int32" }
          }
        ],
        "responses": {
          "204": { "description": "No Content" },
          "401": { "description": "Unauthorized" },
          "404": { "description": "Not Found" }
        }
      }
    },
    "/api/orders/customer/{email}": {
      "get": {
        "tags": [ "Orders" ],
        "operationId": "GetOrdersByCustomerEmail",
        "security": [ { "Bearer": [] } ],
        "parameters": [
          {
            "name": "email",
            "in": "path",
            "required": true,
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": { "$ref": "#/components/schemas/Order" }
                }
              }
            }
          },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "Bearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Order": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int32" },
          "product": { "$ref": "#/components/schemas/ProductRef" },
          "customer": { "$ref": "#/components/schemas/CustomerInfo" },
          "totalPrice": { "type": "number", "format": "decimal" },
          "status": { "$ref": "#/components/schemas/OrderStatus" },
          "audit": { "$ref": "#/components/schemas/AuditInfo" }
        }
      },
      "ProductRef": {
        "type": "object",
        "properties": {
          "productId": { "type": "integer", "format": "int32" },
          "productName": { "type": "string" },
          "unitPrice": { "type": "number", "format": "decimal" },
          "quantity": { "type": "integer", "format": "int32" }
        }
      },
      "CustomerInfo": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "email": { "type": "string" }
        }
      },
      "AuditInfo": {
        "type": "object",
        "properties": {
          "createdAt": { "type": "string", "format": "date-time" },
          "updatedAt": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "OrderStatus": {
        "enum": [ "Pending", "Confirmed", "Shipped", "Delivered", "Cancelled" ],
        "type": "string"
      },
      "CreateOrderRequest": {
        "type": "object",
        "properties": {
          "productId": { "type": "integer", "format": "int32" },
          "customerName": { "type": "string" },
          "customerEmail": { "type": "string" },
          "quantity": { "type": "integer", "format": "int32" }
        }
      },
      "UpdateOrderRequest": {
        "type": "object",
        "properties": {
          "quantity": { "type": "integer", "format": "int32", "nullable": true },
          "status": {
            "nullable": true,
            "oneOf": [ { "$ref": "#/components/schemas/OrderStatus" } ]
          },
          "customerName": { "type": "string", "nullable": true },
          "customerEmail": { "type": "string", "nullable": true }
        }
      }
    }
  }
}
