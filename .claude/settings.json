{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(dotnet restore *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)",
      "Bash(dotnet run --project framework/src/ApiTestFramework.Generator.Cli *)",
      "Bash(python tools/generate_collections.py *)",
      "Bash(python tools/generate_k6.py *)",
      "Bash(python tools/smoke_runner.py *)",
      "Bash(python tools/mock_server.py *)",
      "Bash(docker compose -f examples/demo-shop/docker-compose.yml *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)"
    ],
    "deny": [
      "Edit(/**/*.g.cs)",
      "Edit(/**/Generated/*.cs.txt)",
      "Edit(/examples/*/collections/**)",
      "Edit(/examples/*/perf/k6/**)",
      "Read(/**/.env)",
      "Read(/**/.env.local)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin develop *)",
      "Bash(git push origin main *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/protect_generated.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
